rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Function to check if the user is the Super Admin
    function isSuperAdmin() {
      return request.auth != null && request.auth.token.email == 'abanoublotfy@gmail.com';
    }

    // Function to check if the user owns the tenant workspace
    function isTenantOwner(tenantId) {
      return request.auth != null && request.auth.uid == tenantId;
    }

    match /tenants/{tenantId} {
      allow read: if isSuperAdmin() || isTenantOwner(tenantId);
      allow create: if isSuperAdmin() || isTenantOwner(tenantId);
      allow update: if isSuperAdmin() || isTenantOwner(tenantId);
      allow delete: if isSuperAdmin();
    }

    // Allow tenant owners to read/write their own inventory
    match /inventory/{docId} {
      allow read, update, delete: if isSuperAdmin() || (request.auth != null && resource != null && resource.data.tenantId == request.auth.uid);
      allow create: if isSuperAdmin() || (request.auth != null && request.resource.data.tenantId == request.auth.uid);
    }

    // Allow tenant owners to read/write their own sales
    match /sales/{docId} {
      allow read, update, delete: if isSuperAdmin() || (request.auth != null && resource != null && resource.data.tenantId == request.auth.uid);
      allow create: if isSuperAdmin() || (request.auth != null && request.resource.data.tenantId == request.auth.uid);
    }

    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
